#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")/.." && pwd -P)"
export PATH="/opt/homebrew/bin:$HOME/.asdf/shims:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:$PATH"

if [[ ! -f "${SCRIPT_DIR}/dist/server.mjs" ]]; then
  echo "Error: ${SCRIPT_DIR}/dist/server.mjs not found. Run \"cd ${SCRIPT_DIR} && npm install && npm run build\" first." >&2
  exit 1
fi

exec node "${SCRIPT_DIR}/dist/server.mjs" "$@"
